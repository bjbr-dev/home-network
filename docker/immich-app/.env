# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored. Points at the dedicated "photos" shared
# volume rather than /volume1/docker-data/immich-app (unlike other services' data, this is
# meant to be managed as its own top-level shared folder, not per-service container state).
UPLOAD_LOCATION=/volume1/photos

# The location where your database files are stored — kept outside the repo (see README: Adding Services)
DB_DATA_LOCATION=/volume1/docker-data/immich-app/postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
TZ=Europe/London

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# Connection secret for postgres. Left as the default "postgres" — this file is public but
# the database itself is never exposed outside the internal Docker network, and it doesn't
# store anything sensitive, so a stronger password wouldn't buy any real protection here.
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
